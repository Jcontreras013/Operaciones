# Copiar a .env y ajustar. NUNCA commitear .env con credenciales reales.

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
# Opción A: variables discretas (desarrollo local).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=operaciones
DATABASE_PASSWORD=changeme
DATABASE_NAME=operaciones
# Opción B: cadena de conexión única (producción / Supabase). Tiene prioridad
# sobre las variables discretas si está definida.
# DATABASE_URL=postgresql://usuario:password@host:5432/postgres
# SSL requerido por Supabase y proveedores gestionados:
DATABASE_SSL=false

# En desarrollo, TypeORM sincroniza el esquema automáticamente.
# En producción SIEMPRE debe ser false y usar migraciones.
DATABASE_SYNCHRONIZE=true
# Corre las migraciones pendientes al arrancar (usar en producción):
DATABASE_MIGRATIONS_RUN=false
DATABASE_LOGGING=false

# Autenticación (JWT). En producción usar un secreto fuerte y único.
JWT_SECRET=dev-secret-cambiar-en-produccion
JWT_EXPIRES_IN=1h

# CORS: orígenes permitidos (coma-separados), p. ej. la URL del frontend.
# Vacío = permitir cualquier origen (solo desarrollo).
# CORS_ORIGIN=https://operaciones-web.onrender.com
