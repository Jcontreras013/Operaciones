# Copiar a .env y ajustar. NUNCA commitear .env con credenciales reales.

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
# Opción A: variables discretas (desarrollo local).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=operaciones
DATABASE_PASSWORD=changeme
DATABASE_NAME=operaciones
# Opción B: cadena de conexión única (producción / Supabase). Tiene prioridad
# sobre las variables discretas si está definida.
# DATABASE_URL=postgresql://usuario:password@host:5432/postgres
# SSL requerido por Supabase y proveedores gestionados:
DATABASE_SSL=false

# En desarrollo, TypeORM sincroniza el esquema automáticamente.
# En producción SIEMPRE debe ser false y usar migraciones.
DATABASE_SYNCHRONIZE=true
# Corre las migraciones pendientes al arrancar (usar en producción):
DATABASE_MIGRATIONS_RUN=false
DATABASE_LOGGING=false

# Autenticación (JWT). En producción usar un secreto fuerte y único.
JWT_SECRET=dev-secret-cambiar-en-produccion
JWT_EXPIRES_IN=1h

# CORS: orígenes permitidos (coma-separados), p. ej. la URL del frontend.
# Vacío = permitir cualquier origen (solo desarrollo).
# CORS_ORIGIN=https://operaciones-web.onrender.com

# Conector real de Cepheus (módulo field / Monitor). Sin CEPHEUS_BASE_URL el
# sistema usa el stub con órdenes de ejemplo — no hace falta nada de esto para
# desarrollar. NUNCA reutilizar credenciales que hayan estado expuestas en
# monitor-operativo (ese repo es público): rotarlas en Cepheus/IT primero.
# CEPHEUS_BASE_URL=https://cepheus.tu-dominio.hn/ws/ordenes
# Usuario/contraseña de HTTP Basic Auth contra el webservice:
# CEPHEUS_AUTH_USER=
# CEPHEUS_AUTH_PASSWORD=
# Cuentas de consulta (parámetro ?usuario=) a probar en orden — cada una tiene
# su propio cupo de 5 consultas/hora. Coma-separadas; si se deja vacío se usa
# CEPHEUS_AUTH_USER como única cuenta.
# CEPHEUS_QUERY_USERS=
# CEPHEUS_MEDIOS=FTTH,C
# CEPHEUS_HORA_INICIO=07:00
# Solo si el servidor usa un certificado propio/autofirmado (típico de un
# servidor interno) y las conexiones fallan por TLS:
# CEPHEUS_TLS_INSECURE=false
# CEPHEUS_TIMEOUT_MS=240000

# Ingesta programada de Cepheus (reemplaza al sync_job.py del monitor): corre
# sola, no depende de que alguien pulse "Sincronizar ahora". Por defecto cada
# hora, ventana de 3h (con margen). Ajustar solo si hace falta.
# CEPHEUS_SYNC_CRON=0 * * * *
# CEPHEUS_SYNC_VENTANA_HORAS=3
